RewriteEngine On

# Redirect HTTP to HTTPS for new domain
RewriteCond %{SERVER_PORT} 80
RewriteRule ^(.*)$ https://easycloudsoftware.com/$1 [R,L]

# Force upgrade of insecure requests
Header always set Content-Security-Policy "upgrade-insecure-requests;"

# Preserve HTTP Authorization header
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

RewriteBase /

# ============================================
# PHP EXTENSION REMOVAL - Clean URLs
# ============================================

# Redirect old .php URLs to clean URLs (301 Permanent Redirect)
# Example: /blogs.php -> /blogs
RewriteCond %{THE_REQUEST} \s/(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Redirect old .php URLs in blogs subdirectory
# Example: /blogs/bom.php -> /blogs/bom
RewriteCond %{THE_REQUEST} \s/blogs/(.+?)\.php[\s?] [NC]
RewriteRule ^ /blogs/%1 [R=301,L,NE]

# Internal rewrite: Map clean URLs to .php files
# Example: /blogs -> /blogs.php (when blogs.php exists)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Internal rewrite for blogs subdirectory
# Example: /blogs/bom -> /blogs/bom.php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^blogs/(.+?)/?$ blogs/$1.php [L,QSA]

# ============================================
# HTML EXTENSION HANDLING (existing rules)
# ============================================

# --- EXEMPT blogs.html from .html removal ---
RewriteCond %{THE_REQUEST} \s/([^\s]+?)\.html(\s|\?) [NC]
RewriteCond %{REQUEST_URI} !^/blogs\.html$ [NC]
RewriteRule ^ %1 [R=301,L,NE]
# --------------------------------------------

# Internally map /page -> /page.html (ONLY when file exists and not a directory)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Skip rewriting if it's index.html
RewriteRule ^(.*/)?index\.html$ - [L]

# SPA fallback
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
